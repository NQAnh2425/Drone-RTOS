#include "SBUS.h"


static uint8_t header_pos;

// configure UART interrupt, data length = 25 bytes
SBUS_status_t SBUS_Init(UART_HandleTypeDef *huart, uint8_t* SBUS_data_raw)
{
	if (HAL_UART_Receive_IT(huart, SBUS_data_raw, 25) != HAL_OK)
	{
		return SBUS_INIT_FAIL;
	}
	return SBUS_OK;
}





void SBUS_Decode(uint8_t *buf, uint16_t *ch)
{
    ch[0]  = ((buf[(header_pos+1)%SBUS_FRAME_LEN]      | buf[header_pos+2]  << 8)                         & 0x07FF);
    ch[1]  = ((buf[header_pos+2] >> 3 | buf[header_pos+3]  << 5)                         & 0x07FF);
    ch[2]  = ((buf[header_pos+3] >> 6 | buf[header_pos+4]  << 2 | buf[header_pos+5]  << 10)         & 0x07FF);
    ch[3]  = ((buf[header_pos+5] >> 1 | buf[header_pos+6]  << 7)                         & 0x07FF);
    ch[4]  = ((buf[header_pos+6] >> 4 | buf[header_pos+7]  << 4)                         & 0x07FF);
    ch[5]  = ((buf[header_pos+7] >> 7 | buf[header_pos+8]  << 1 | buf[header_pos+9]  << 9)          & 0x07FF);
    ch[6]  = ((buf[header_pos+9] >> 2 | buf[header_pos+10] << 6)                         & 0x07FF);
    ch[7]  = ((buf[header_pos+10]>>5 | buf[header_pos+11] <<3)                           & 0x07FF);

    ch[8]  = ((buf[header_pos+12]     | buf[header_pos+13] <<8)                          & 0x07FF);
    ch[9]  = ((buf[header_pos+13]>>3  | buf[header_pos+14] <<5)                          & 0x07FF);
    ch[10] = ((buf[header_pos+14]>>6  | buf[header_pos+15] <<2 | buf[header_pos+16]<<10)            & 0x07FF);
    ch[11] = ((buf[header_pos+16]>>1  | buf[header_pos+17] <<7)                          & 0x07FF);
    ch[12] = ((buf[header_pos+17]>>4  | buf[header_pos+18] <<4)                          & 0x07FF);
    ch[13] = ((buf[header_pos+18]>>7  | buf[header_pos+19] <<1 | buf[header_pos+20]<<9)             & 0x07FF);
    ch[14] = ((buf[header_pos+20]>>2  | buf[header_pos+21] <<6)                          & 0x07FF);
    ch[15] = ((buf[header_pos+21]>>5  | buf[header_pos+22] <<3)                          & 0x07FF);
}


int8_t SBUS_FindFrame(uint8_t *buf)
{
    for(uint16_t i = 0; i < SBUS_FRAME_LEN; i++)
    {
        if(buf[i] != 0x0F)
        	continue;

        if(buf[(i + 24)%SBUS_FRAME_LEN] != 0x00)
            continue;
        header_pos = i;
        return i;
    }

    return -1;
}


bool SBUS_IsFrameLost( uint8_t *buf)
{
    return (buf[header_pos + 23] & (1 << 2)) != 0;
}

bool SBUS_IsFailsafe( uint8_t *buf)
{
    return (buf[(header_pos + 23)%SBUS_FRAME_LEN] & (1 << 3)) != 0;
}


SBUS_status_t SBUS_CheckFrame( uint8_t *buf)
{
	if(SBUS_FindFrame(buf, FRAME_LENGHT) == -1)
		return SBUS_FRAME_NOTFOND;
	if (SBUS_IsFrameLost(buf))
		return SBUS_ERR_FRAME_LOST;
	if (SBUS_IsFailsafe(buf))
		return SBUS_ERR_FAILSAFE;
    return SBUS_OK;
}



uint16_t SBUS_GetChannel(uint8_t ch, const uint16_t *channel)
{
    if (channel == NULL)
    {
        return 0;
    }

    if (ch >= SBUS_CHANNEL_NUM)
    {
        return 0;
    }

    return channel[ch];
}


void SBUS_clear_old_data(uint8_t *SBUS_data_rx)
{
	for(uint8_t i = 0; i<= 24; i++)
	{
		SBUS_data_rx[i] = 0;
	}
}






