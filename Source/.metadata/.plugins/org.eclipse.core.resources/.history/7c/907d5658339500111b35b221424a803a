
#include "ESC.h"



esc_status_t esc_init(TIM_HandleTypeDef *htim)
{
    if (HAL_TIM_PWM_Start(htim, TIM_CHANNEL_1) != HAL_OK)
        return ESC_FAIL;

    if (HAL_TIM_PWM_Start(htim, TIM_CHANNEL_2) != HAL_OK)
        return ESC_FAIL;

    if (HAL_TIM_PWM_Start(htim, TIM_CHANNEL_3) != HAL_OK)
        return ESC_FAIL;

    if (HAL_TIM_PWM_Start(htim, TIM_CHANNEL_4) != HAL_OK)
        return ESC_FAIL;

    return ESC_OK;
}


esc_status_t esc_set_channel(TIM_HandleTypeDef *htim, uint32_t tim_channel , uint16_t set_value)
{
    __HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_1, set_value);
    __HAL_TIM_GET_COMPARE(htim, TIM_CHANNEL_1);
}

void esc_stop_channel(TIM_HandleTypeDef *htim, uint32_t channel)
{
	switch (channel)
	{
		case(TIM_CHANNEL_1):
		{
			__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_1, 1000);
			break;
		}
		case(TIM_CHANNEL_2):
		{
			__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_2, 1000);
			break;
		}
	case(TIM_CHANNEL_3):
		{
			__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_3, 1000);
			break;
		}
	case(TIM_CHANNEL_4):
		{
			__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_4, 1000);
			break;
		}
	default:
			return;
	}
}

void esc_stop_all(TIM_HandleTypeDef *htim)
{
	__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_1, 1000);
	__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_2, 1000);
	__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_3, 1000);
	__HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_4, 1000);
}

void esc_set_all(TIM_HandleTypeDef *htim, uint16_t set_value)
{
    __HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_1, set_value);
    __HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_2, set_value);
    __HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_3, set_value);
    __HAL_TIM_SET_COMPARE(htim, TIM_CHANNEL_4, set_value);
}
