#ifndef SBUS_H_
#define SBUS_H_

#include "main.h"
#include "stdint.h"
#include "stdbool.h"


#define SBUS_FRAME_LEN			((uint16_t) 25)
#define SBUS_CHANNEL_NUM    	16



typedef enum
{
    SBUS_OK = 0,
	SBUS_FRAME_NOTFOND,
    SBUS_ERR_FRAME_LOST,
    SBUS_ERR_FAILSAFE,
} SBUS_status_t;

#include "main.h"

SBUS_status_t SBUS_Init(UART_HandleTypeDef *huart, uint8_t* SBUS_data_raw);

SBUS_status_t SBUS_rx_callback(uint8_t *SBUS_data_raw);

void SBUS_process_frame(void);

void SBUS_Decode(uint8_t *buf, uint16_t *ch);


int8_t SBUS_FindFrame(uint8_t *buf, uint8_t len)
{
    for(uint16_t i = 0; i + SBUS_FRAME_LEN <= len; i++)
    {
        if(buf[i] != 0x0F)
        	continue;

        if(buf[(i + 24)%len] != 0x00)
            continue;
        header_pos = i;
        return i;
    }

    return -1;
}


bool SBUS_IsFrameLost( uint8_t *buf)
{
    return (buf[header_pos + 23] & (1 << 2)) != 0;
}

bool SBUS_IsFailsafe( uint8_t *buf)
{
    return (buf[header_pos + 23] & (1 << 3)) != 0;
}


uint16_t SBUS_GetChannel(uint8_t ch, const uint16_t *channel);

SBUS_status_t SBUS_CheckFrame( uint8_t *buf);

void SBUS_clear_old_data(uint8_t *SBUS_data_rx);





#endif /* SBUS_H_ */
