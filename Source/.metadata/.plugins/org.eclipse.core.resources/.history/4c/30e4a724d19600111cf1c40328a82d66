#ifndef MOTOR_H_
#define MOTOR_H_

#include "ESC.h"

typedef enum
{
	MOTOR_1,
	MOTOR_2,
	MOTOR_3,
	MOTOR_4,
}Motor_ID_t;

typedef enum
{
	MOTOR_OK,
	MOTOR_FAIL,
}Motor_status_t;



typedef struct
{
	Motor_ID_t motorid;
	uint32_t   tim_channel;
	TIM_HandleTypeDef *htim;
	uint8_t			speed_percent;
}MOTOR_Handle_t;

void motor_init(MOTOR_Handle_t *motor_handle, TIM_HandleTypeDef *htim)
{
	  for(uint8_t i = 0; i <= 3 ; i++)
	  {
		  motor_handle[i].htim = &htim1;
		  motor_handle[i].motorid = i+1;
		  motor_handle[i].speed_percent = 0;
	  }
	  motor_handle[0].tim_channel = TIM_CHANNEL_1;
	  motor_handle[1].tim_channel = TIM_CHANNEL_2;
	  motor_handle[2].tim_channel = TIM_CHANNEL_3;
	  motor_handle[3].tim_channel = TIM_CHANNEL_4;
}

Motor_status_t motor_set_speed ( MOTOR_Handle_t *motor_handle ,uint16_t motor_speed);

Motor_status_t motor_stop( MOTOR_Handle_t *motor_handle);

Motor_status_t motor_stop_all (MOTOR_Handle_t *motor_handle);


#endif /* MOTOR_H_ */
