#include "rate_control.h"






void RC_command_to_angular_rate(uint16_t * channel, RC_command_t *rc_command)
{
	rc_command->target_pitch_rate = ((float)channel[1] - 160)*(MAX_ANGULAR_RATE - MIN_ANGULAR_RATE)/(SBUS_CHANNEL_MAX - SBUS_CHANNEL_MIN) + MIN_ANGULAR_RATE;
	rc_command->target_roll_rate = ((float)channel[0] - 160)*(MAX_ANGULAR_RATE - MIN_ANGULAR_RATE)/(SBUS_CHANNEL_MAX - SBUS_CHANNEL_MIN) + MIN_ANGULAR_RATE;
	rc_command->target_throttle_rate = ((float)channel[2] - 160)*100/(MAX_RC_CMD_THROTTLE_RATE - MIN_RC_CMD_THROTTLE_RATE);
	rc_command->target_yaw_rate = ((float)channel[3] - 160)*(MAX_ANGULAR_RATE - MIN_ANGULAR_RATE)/(SBUS_CHANNEL_MAX - SBUS_CHANNEL_MIN) + MIN_ANGULAR_RATE;
}

typedef struct
{
	float rate_error[3];
	float prev_rate_error[3];
	float prev_Iterm[3];
}PID_input_t;


void PID_calculate_error(MPU6050_Handle_t *mpu6050_handle,
                         RC_command_t *rc_command,
                         PID_input_t *pid_input)
{
    float gyro_x;
    float gyro_y;
    float gyro_z;

    /* Read angular velocity from MPU6050 */
    MPU6050_Read_Gyro(mpu6050_handle, &gyro_x, &gyro_y, &gyro_z);

    /*
     * Axis mapping:
     * X -> Roll
     * Y -> Pitch
     * Z -> Yaw
     */

    /* Save previous error */
    pid_input->prev_rate_error[0] = pid_input->rate_error[0];
    pid_input->prev_rate_error[1] = pid_input->rate_error[1];
    pid_input->prev_rate_error[2] = pid_input->rate_error[2];

    /* Calculate rate error */
    pid_input->rate_error[0] =
        rc_command->target_roll_rate - gyro_x;

    pid_input->rate_error[1] =
        rc_command->target_pitch_rate - gyro_y;

    pid_input->rate_error[2] =
        rc_command->target_yaw_rate - gyro_z;
}

