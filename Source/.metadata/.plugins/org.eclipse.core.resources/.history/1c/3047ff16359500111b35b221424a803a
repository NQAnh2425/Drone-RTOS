#ifndef MOTOR_H_
#define MOTOR_H_

#include "ESC.h"

typedef enum
{
	MOTOR_1,
	MOTOR_2,
	MOTOR_3,
	MOTOR_4,
	MOTOR_ALL,
}Motor_ID_t;

typedef enum
{
	MOTOR_OK,
	MOTOR_FAIL,
}Motor_status_t;

typedef struct
{
	const Motor_ID_t motorid;
	const uint32_t   tim_channel;
	const TIM_HandleTypeDef *htim;
	uint8_t			speed_percent;
}MOTOR_Handle_t;

Motor_status_t motor_set_speed_percent ( MOTOR_Handle_t *motor_handle ,uint8_t percent)
{
	uint16_t set_value = 0;

	if(percent >= 100)
	{

		if(esc_set_channel(motor_handle->htim, motor_handle->tim_channel ,set_value) != ESC_OK)
		return MOTOR_FAIL;
	}
	set_value = percent*10+1000;
	if(esc_set_channel(motor_handle->htim, motor_handle->tim_channel ,set_value) != ESC_OK)
	return MOTOR_FAIL;

	return MOTOR_OK;
}

Motor_status_t motor_stop( MOTOR_Handle_t motor_handle)
{
	if(motor_stop(motor_handle->htim,motor_handle->tim_channel) != ESC_OK)
		return MOTOR_FAIL;
	return MOTOR_OK;
}

Motor_status_t motor_stop_all (MOTOR_Handle_t motor_handle)
{
	if(esc_stop_all(motor_handle->htim) != ESC_OK)
	return MOTOR_FAIL;
return MOTOR_OK;
}

#endif /* MOTOR_H_ */
