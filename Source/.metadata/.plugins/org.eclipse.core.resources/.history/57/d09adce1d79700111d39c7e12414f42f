/**
  * @brief  This function is executed in case of error occurrence.
  * @retval None
  */
void Error_Handler(void)
{
  /* USER CODE BEGIN Error_Handler_Debug */
  /* User can add his own implementation to report the HAL error return state */
  __disable_irq();
  while (1)
  {
	  HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_2);
	  switch(drone_handle.error_code)
	  {
	  case(ERROR_TIMEOUT):
			  mprint("ERROR TIMEOUT\n");
			  break;
	  case(ERROR_ESC_INIT):
			  mprint("ERROR ESC INIT\n");
			  break;
	  case(ERROR_MPU_INIT):
			  mprint("ERROR MPU INIT\n");
			  break;
	  case(ERROR_MPU_UNSTABLE):
			  mprint("ERROR MPU UNSTABLE\n");
			  break;
	  case(ERROR_SBUS_INIT):
			  mprint("ERROR SBUS INIT\n");
			  break;
	  case(ERROR_NONE):
			  break;
	  default:
		  break;
	  }
	  uint32_t i = 0x00ffffff;
	  while(i--);
  }
  /* USER CODE END Error_Handler_Debug */
}

