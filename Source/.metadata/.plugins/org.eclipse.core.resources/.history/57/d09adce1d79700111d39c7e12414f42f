/* USER CODE BEGIN 4 */

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
	if(huart->Instance == USART1)
	{
		receive_flag = 1;
		if (  HAL_UART_Receive_DMA(huart, SBUS_raw_data_rx, sizeof(SBUS_raw_data_rx)) != HAL_OK)
			{
			drone_handle.error_code = ERROR_SBUS_INIT;
			Error_Handler();
			}
	}
	else
	{
		if (  HAL_UART_Receive_DMA(huart, SBUS_raw_data_rx, sizeof(SBUS_raw_data_rx)) != HAL_OK)
			{
			drone_handle.error_code = ERROR_SBUS_INIT;
			Error_Handler();
			}
	}
}

