#include "PID.h"

extern UART_HandleTypeDef huart2;

float ascii_to_float(char *str)
{
    float result = 0.0f;
    float decimal = 0.1f;
    int sign = 1;

    // Bỏ khoảng trắng
    while (*str == ' ' || *str == '\t')
    {
        str++;
    }

    // Xử lý dấu
    if (*str == '-')
    {
        sign = -1;
        str++;
    }
    else if (*str == '+')
    {
        str++;
    }

    // Phần nguyên
    while (*str >= '0' && *str <= '9')
    {
        result = result * 10.0f + (*str - '0');
        str++;
    }

    // Phần thập phân
    if (*str == '.')
    {
        str++;

        while (*str >= '0' && *str <= '9')
        {
            result += (*str - '0') * decimal;
            decimal *= 0.1f;
            str++;
        }
    }

    return result * sign;
}

uint8_t PID_setting()
{
	uint8_t pid_setting_buff[15];
	uint16_t rx_len;
	LOG("setting syntax: P I D\n");
	LOG("example: 2 0.02 0.5 correspond P = 2, I = 0.02, D = 0.5\n");
	LOG("setting Pitch PID:\n ");
	if(HAL_UARTEx_ReceiveToIdle(&huart2, pid_setting_buff,15,&rx_len,5000) == HAL_OK)
	{
		ascii_to_float(pid_setting_buff);
	}
}

