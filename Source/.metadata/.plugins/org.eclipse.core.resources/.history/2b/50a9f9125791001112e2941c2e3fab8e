#ifndef MPU6050_H_
#define MPU6050_H_



#include "main.h"
#include "stdio.h"


#define MPU6050_CALIBRATE


#define MPU6050_ADDR		( ((uint8_t)(0x68<<1)) )
#define I2C_TIMEOUT			500U


/*========================MPU6050 register address================*/
#define WHO_I_AM			((uint8_t) 117)
#define PWMGMT_1			((uint8_t) 107)
#define ACCEL_XOUT_H		((uint8_t) 59)
#define GYRO_XOUT_H			((uint8_t) 0x43)

#define SMPRT_DIV			((uint8_t) 0x19)
#define DLPF_CFG			((uint8_t) 0x1A)
#define	GYRO_CONFIG			((uint8_t) 0x1B)
#define ACCEL_CONFIG		((uint8_t) 0x1C)
#define INT_PIN_CFG			((uint8_t) 0x37)
#define REG_INT_EN			((uint8_t) 0x38)
#define REG_INT_STATUS		((uint8_t) 0x3A)



typedef enum {
	MPU6050_OK,
	MPU6050_ERR,
}mpu6050_status_t;



typedef struct {
	int16_t acel_x;
	int16_t acel_y;
	int16_t acel_z;
	int16_t gyro_x;
	int16_t gyro_y;
	int16_t gyro_z;
}	mpu6050_data;


typedef enum
{
	INT_LEVEL_ACTIVE_HIGH = 0x00,
	INT_LEVEL_ACTIVE_LOW,
}mpu6050_interrupt_config_t;

typedef enum
{
	RAW_RDY_INT =  0x01,
	I2C_MST_INT =  0x08, // set bit 3 to enable all interrupts
	FIFO_OFW_INT = 0x10,
	MOT_INT = 	0x40,
	ALL_INT = 0xFF,

}mpu6050_interrupt_t;



mpu6050_status_t mpu6050_read_byte(I2C_HandleTypeDef *hi2c,uint8_t mpu_i2c_addr, uint8_t reg_addr, uint8_t *data);
mpu6050_status_t mpu6050_write_byte(I2C_HandleTypeDef *hi2c,uint8_t mpu_i2c_addr, uint8_t reg_addr, uint8_t *data);


mpu6050_status_t mpu6050_init(I2C_HandleTypeDef *hi2c,uint8_t mpu_i2c_addr);
mpu6050_status_t mpu6050_read_data(I2C_HandleTypeDef *hi2c,uint8_t mpu_i2c_addr, mpu6050_data *mpu6050_data);

void mpu6050_read_gyro(float *gyro_data, mpu6050_data *mpu6050_data);
void mpu6050_read_accel(float *accel_data, mpu6050_data *mpu6050_data);

mpu6050_status_t mpu6050_interrupt_config(I2C_HandleTypeDef *hi2c, uint8_t mpu_i2c_addr ,mpu6050_interrupt_config_t level);
mpu6050_status_t mpu6050_enable_interrupt(I2C_HandleTypeDef *hi2c,uint8_t mpu_i2c_addr, mpu6050_interrupt_t interrupt);
mpu6050_status_t mpu6050_disable_interrupt(I2C_HandleTypeDef *hi2c, uint8_t mpu_i2c_addr , mpu6050_interrupt_t interrupt);


void mpu6050_interrupt_handle(I2C_HandleTypeDef *hi2c);
void mpu6050_motion_detection_callback();
void mpu6050_raw_data_ready_callback();
void mpu6050_calibrate(uint32_t *raw_gyroscope_data,uint16 sample)


#endif /* MPU6050_H_ */
