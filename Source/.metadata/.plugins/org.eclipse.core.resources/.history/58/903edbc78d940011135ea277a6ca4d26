#include "main.h"
#include "SBUS.h"
#include "app_callback.h"


extern UART_HandleTypeDef huart1;
extern uint8_t receive_flag;
extern uint8_t SBUS_raw_data_rx[SBUS_FRAME_LEN];
extern error_code_t error_code;


void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
	if(huart->Instance == USART1)
	{
		receive_flag = 1;
		if(HAL_UARTEx_ReceiveToIdle_DMA(huart, SBUS_raw_data_rx, sizeof(SBUS_raw_data_rx)) != HAL_OK)
			{
			error_code = ERROR_SBUS_INIT;
			Error_Handler();
			}
	}
	else
	{
		if(HAL_UARTEx_ReceiveToIdle_DMA(huart, SBUS_raw_data_rx, sizeof(SBUS_raw_data_rx)) != HAL_OK)
			{
			error_code = ERROR_SBUS_INIT;
			Error_Handler();
			}
	}
}
