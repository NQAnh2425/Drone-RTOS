void MPU_Init(void)
{
	uint8_t reg_data;
	HAL_I2C_Mem_Read(&hi2c1, MPU_ADDR << 1 , WHO_AM_I , I2C_MEMADD_SIZE_8BIT, &reg_data , 3, 1000);

	if(reg_data == 0x70)
	{
		reg_data = 0x01;

		HAL_I2C_Mem_Write(&hi2c1, MPU_ADDR << 1, PWR_MGMT_1, I2C_MEMADD_SIZE_8BIT, &reg_data , 1, 1000);

		reg_data = 0x00;

		HAL_I2C_Mem_Write(&hi2c1, MPU_ADDR << 1, SMPRT_DIV , I2C_MEMADD_SIZE_8BIT, &reg_data , 1, 1000);

		HAL_I2C_Mem_Write(&hi2c1, MPU_ADDR << 1, GYRO_CONFIG , I2C_MEMADD_SIZE_8BIT, &reg_data , 1, 1000);

		HAL_I2C_Mem_Write(&hi2c1, MPU_ADDR << 1, ACCEL_CONFIG, I2C_MEMADD_SIZE_8BIT, &reg_data , 1, 1000);
	}
	else
	{
		while(1)
		{
			;
		}
	}

}


void MPU_Read_Gyro(void)
{
	uint8_t data_gyro[6] = {0};
	HAL_I2C_Mem_Read(&hi2c1, MPU_ADDR << 1, GYRO_XOUT_H , I2C_MEMADD_SIZE_8BIT, data_gyro, 6, 1000);
	gx = ((int16_t)(data_gyro[0]) << 8) | data_gyro[1];
	gy = ((int16_t)(data_gyro[2]) << 8) | data_gyro[3];
	gz = ((int16_t)(data_gyro[4]) << 8) | data_gyro[5];

	Gx = ((float)gx) / 131.0;
	Gy = ((float)gy) / 131.0;
	Gz = ((float)gz) / 131.0;

}


void MPU_Read_Accel(void)
{
	uint8_t data_accel[6] = {0};
	HAL_I2C_Mem_Read(&hi2c1, MPU_ADDR << 1, ACCEL_XOUT_H , I2C_MEMADD_SIZE_8BIT, data_accel, 6, 1000);
	ax = ((int16_t)(data_accel[0]) << 8) | data_accel[1];
	ay = ((int16_t)(data_accel[2]) << 8) | data_accel[3];
	az = ((int16_t)(data_accel[4]) << 8) | data_accel[5];

	Ax = ((float)ax) / 16384.0;
	Ay = ((float)ay) / 16384.0;
	Az = ((float)az) / 16384.0;


}


void complementary_filter (float Ax, float Ay, float Az, float Gx, float Gy, float Gz)
{
	float pitchG = pitch + Gx*(10000/1000000.0f);
	float rollG = roll + Gy*(10000/1000000.0f);

	float pitchA = (atan2(Ay, sqrt(Ax*Ax + Az*Az)) * 18000)/314;
	float rollA = (atan2(Ax, sqrt(Ay*Ay + Az*Az)) * 18000)/314;

	pitch = 0.98*pitchG + 0.02*pitchA;
	roll = 0.98*rollG + 0.02*rollA;
}

void MPU_calibrate(float *gyro_offset)
{
	Gx -= gyro_offset[0];
	Gy -= gyro_offset[1];
	Gz -= gyro_offset[3];
}
